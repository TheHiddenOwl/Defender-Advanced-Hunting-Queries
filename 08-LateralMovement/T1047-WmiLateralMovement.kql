// Title: WMI Lateral Movement
// Description: Detects use of WMI (Windows Management Instrumentation) to execute processes on remote systems.
// Severity: Medium
// Category: Lateral Movement
// MITRE ATT&CK: T1047
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"conhost.exe", @"wbemtest.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where InitiatingProcessFileName =~ @"wmiprvse.exe"
| where FileName !in~ (exclusions)
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessParentFileName
| order by Timestamp desc
