// Title: Windows Event Log Cleared
// Description: Detects the clearing of Windows Event Logs via wevtutil or PowerShell
// Severity: High
// Category: Defense Evasion
// MITRE ATT&CK: T1070.001
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"MaintenanceScript.ps1"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where (FileName =~ @"wevtutil.exe" and ProcessCommandLine has @"cl") or
        (FileName in~ (@"powershell.exe", @"pwsh.exe") and ProcessCommandLine has @"Clear-EventLog")
| where not(ProcessCommandLine has_any (exclusions))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, ProcessCommandLine
| top 100 by Timestamp desc
