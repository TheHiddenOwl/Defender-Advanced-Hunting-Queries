// Title: Clearing Windows Event Logs
// Description: Detects attempts to clear Windows Event Logs using wevtutil or PowerShell, a common defense evasion tactic.
// Severity: High
// Category: Defense Evasion
// MITRE ATT&CK: T1070.001
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where (FileName =~ @"wevtutil.exe" and ProcessCommandLine has_any (@"cl ", @"clear-log ")) or (FileName =~ @"powershell.exe" and ProcessCommandLine has @"Clear-EventLog")
| project Timestamp, DeviceName, AccountName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
