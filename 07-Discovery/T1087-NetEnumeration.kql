// Title: Net Enumeration Commands
// Description: Detects net.exe/net1.exe used for user, group, share, and session enumeration. Common post-exploitation activity.
// Severity: Medium
// Category: Discovery
// MITRE ATT&CK: T1087, T1069, T1016
// Author: TheHiddenOwl

let lookback = 7d;
let enumArgs = dynamic([@"user", @"localgroup", @"group", @"share", @"view", @"session", @"accounts", @"use"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (@"net.exe", @"net1.exe")
| where ProcessCommandLine has_any (enumArgs)
| extend CleanCmd = trim(@" ", ProcessCommandLine)
| project Timestamp, DeviceName, AccountName, CleanCmd, InitiatingProcessFileName, InitiatingProcessCommandLine
| order by Timestamp desc
