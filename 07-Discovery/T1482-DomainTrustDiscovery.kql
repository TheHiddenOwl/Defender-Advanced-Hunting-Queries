// Title: Domain Trust Discovery
// Description: Detects Active Directory domain trust discovery using nltest.exe
// Severity: Low
// Category: Discovery
// MITRE ATT&CK: T1482
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"DomainAdmin"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName =~ @"nltest.exe"
| where ProcessCommandLine has_any (@"/domain_trusts", @"/all_trusts", @"/dclist")
| where not(AccountName has_any (exclusions))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, ProcessCommandLine
| top 100 by Timestamp desc
