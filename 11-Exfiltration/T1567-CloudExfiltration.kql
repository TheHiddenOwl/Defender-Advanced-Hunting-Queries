// Title: Large Data Upload to Cloud Storage
// Description: Detects large outbound network connections to common cloud storage providers, potential exfiltration.
// Severity: Medium
// Category: Exfiltration
// MITRE ATT&CK: T1567
// Author: TheHiddenOwl

let lookback = 7d;
let CloudStorageDomains = pack_array(@"dropbox.com", @"onedrive.live.com", @"mega.nz", @"drive.google.com");
DeviceNetworkEvents
| where Timestamp > ago(lookback)
| where RemoteUrl has_any (CloudStorageDomains)
| summarize TotalBytesSent = sum(BytesSent) by DeviceName, RemoteUrl, bin(Timestamp, 1h)
| where TotalBytesSent > 100000000 // 100MB threshold
| project Timestamp, DeviceName, RemoteUrl, TotalBytesSent
| order by Timestamp desc
