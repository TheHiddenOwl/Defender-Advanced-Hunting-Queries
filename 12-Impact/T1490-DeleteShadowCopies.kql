// Title: Shadow Copy Deletion
// Description: Detects ransomware-like behavior attempting to delete Volume Shadow Copies
// Severity: High
// Category: Impact
// MITRE ATT&CK: T1490
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"BackupSoftware.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (@"vssadmin.exe", @"wmic.exe", @"powershell.exe", @"pwsh.exe")
| where (ProcessCommandLine has_all (@"shadows", @"delete")) or (ProcessCommandLine has @"Win32_ShadowCopy")
| where not(InitiatingProcessFileName has_any (exclusions))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, ProcessCommandLine
| top 100 by Timestamp desc
