// Title: Suspicious Archiving
// Description: Detects suspicious command-line archiving of files (staging for exfiltration)
// Severity: Low
// Category: Collection
// MITRE ATT&CK: T1560
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"BackupTool.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (@"7z.exe", @"winrar.exe", @"tar.exe") or (FileName =~ @"powershell.exe" and ProcessCommandLine has @"Compress-Archive")
| where ProcessCommandLine has_any (@".zip", @".rar", @".7z", @".tar.gz")
| where not(InitiatingProcessFileName has_any (exclusions))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, ProcessCommandLine
| top 100 by Timestamp desc
