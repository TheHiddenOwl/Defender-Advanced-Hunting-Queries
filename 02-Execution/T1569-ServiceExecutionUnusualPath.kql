// Title: Service Execution from Unusual Paths
// Description: Detects services.exe launching binaries from suspicious directories like C:\Windows\Temp or C:\Users\Public.
// Severity: High
// Category: Execution
// MITRE ATT&CK: T1569
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([]);
let suspicious_paths = dynamic([@"C:\Windows\Temp\", @"C:\Users\Public\", @"C:\ProgramData\"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where ParentFileName =~ @"services.exe"
| where FolderPath has_any (suspicious_paths)
| where ProcessCommandLine !in (exclusions)
| project Timestamp, DeviceName, FileName, FolderPath, ProcessCommandLine, AccountName
