// Title: PowerShell Execution with Encoded or Hidden Window
// Description: Detects PowerShell execution using encoded commands or hidden windows
// Severity: Medium
// Category: Execution
// MITRE ATT&CK: T1059.001
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([@"SafeScript.ps1"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (@"powershell.exe", @"pwsh.exe")
| where ProcessCommandLine has_any (@"-enc", @"-EncodedCommand", @"-w hidden", @"-WindowStyle Hidden")
| where not(ProcessCommandLine has_any (exclusions))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, ProcessCommandLine
| top 100 by Timestamp desc
