// Title: Encoded PowerShell Execution
// Description: Detects PowerShell processes with Base64 encoded commands, often used to bypass basic string detection.
// Severity: Medium
// Category: Execution
// MITRE ATT&CK: T1059.001
// Author: TheHiddenOwl

DeviceProcessEvents
| where FileName in~ (@"powershell.exe", @"pwsh.exe")
| where ProcessCommandLine has_any (@"-encodedcommand", @"-enc", @"-e ")
| extend EncodedCommand = extract(@"(?i)-e(?:ncod?e?d?c?o?m?m?a?n?d?)?\s+([A-Za-z0-9+/=]+)", 1, ProcessCommandLine)
| where isnotempty(EncodedCommand)
| project TimeGenerated, DeviceName, AccountName, ProcessCommandLine, EncodedCommand
