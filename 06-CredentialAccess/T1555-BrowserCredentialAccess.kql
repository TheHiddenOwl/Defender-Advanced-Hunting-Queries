// Title: Unauthorized Access to Browser Password Stores
// Description: Detects unauthorized processes (anything other than msedge.exe) accessing the Login Data SQLite databases used by Microsoft Edge.
// Severity: Medium
// Category: Credential Access
// MITRE ATT&CK: T1555
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([]);
DeviceFileEvents
| where Timestamp > ago(lookback)
| where FileName =~ @"Login Data"
| where FolderPath has @"Microsoft\Edge\User Data\Default"
| where InitiatingProcessFileName !=~ @"msedge.exe"
| where InitiatingProcessFileName !in (exclusions)
| project Timestamp, DeviceName, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, AccountName
