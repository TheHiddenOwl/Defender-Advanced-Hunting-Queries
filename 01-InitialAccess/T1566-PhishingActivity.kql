// Title: Phishing link followed by suspicious process
// Description: Detects when a user clicks a link in an email (Outlook/Webmail) and subsequently a suspicious process is spawned.
// Severity: High
// Category: Initial Access
// MITRE ATT&CK: T1566
// Author: TheHiddenOwl

let lookback = 7d;
let exclusions = dynamic([]);
let SuspiciousProcesses = pack_array(@"powershell.exe", @"cmd.exe", @"mshta.exe", @"wscript.exe", @"cscript.exe");
DeviceNetworkEvents
| where Timestamp > ago(lookback)
| where InitiatingProcessFileName in~ (@"outlook.exe", @"chrome.exe", @"msedge.exe", @"iexplore.exe")
| where RemoteUrl != @""
| project NetworkTime = Timestamp, DeviceId, DeviceName, InitiatingProcessFileName, RemoteUrl
| join kind=inner (
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where FileName in~ (SuspiciousProcesses)
    | project ProcessTime = Timestamp, DeviceId, FileName, ProcessCommandLine, InitiatingProcessFileName
) on DeviceId
| where ProcessTime between (NetworkTime .. (NetworkTime + 5m))
| project Timestamp = ProcessTime, DeviceName, InitiatingProcessFileName, FileName, ProcessCommandLine, RemoteUrl
| order by Timestamp desc
